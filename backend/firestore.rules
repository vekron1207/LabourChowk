rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user owns the resource
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Users collection
    match /users/{userId} {
      // Anyone can read user profiles (for browsing labour)
      allow read: if true;
      // Only the user can create/update their own profile
      allow create, update: if isAuthenticated() && isOwner(userId);
      // No deletion allowed
      allow delete: if false;
    }

    // Labour profiles collection
    match /labourProfiles/{profileId} {
      // Anyone can read labour profiles
      allow read: if true;
      // Only the profile owner can update
      allow create, update: if isAuthenticated() && isOwner(resource.data.userId);
      // No deletion allowed
      allow delete: if false;
    }

    // Jobs collection
    match /jobs/{jobId} {
      // Anyone can read jobs
      allow read: if true;
      // Only authenticated users can create jobs
      allow create: if isAuthenticated();
      // Only job poster can update/delete
      allow update, delete: if isAuthenticated() && isOwner(resource.data.postedBy);
    }
  }
}
